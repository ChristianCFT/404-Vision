# Ajustes opcionais do backend 404-Vision.
# Copie para ".env" (ou exporte no terminal). Todos têm um padrão sensato.

# --- Fórmula de climatização ---
AC_T_CONFORTO=23      # temperatura ideal da sala (°C)
AC_K=0.05             # quanto cada pessoa esquenta a sala (°C/pessoa)
AC_N_MAX=80           # lotação máxima da sala (lugares)

# --- Base de imagens (dataset) ---
# AC_DATA_DIR=../data               # pasta da base
# AC_IMAGENS_DIR=../data/images     # fotos da sala
# AC_LABELS_CSV=../data/labels.csv  # contagem real de cada foto
# AC_FEED_DIR=../data/images        # o que a "câmera" mostra (padrão: a base)

# --- Câmera / feed de cenas ---
AC_CICLO_S=5          # segundos que cada cena fica no ar
AC_NUM_APARELHOS=4    # quantos ares-condicionados a sala tem
AC_SALA=Sala B-03
AC_CAMERA=Câmera 1
AC_PESSOAS_MINIMAS=2  # contagem abaixo disso conta como sala vazia (1 = sem zona morta)

# --- YOLO (detecção de pessoas) -------------------------------------------
# Os padrões abaixo foram escolhidos medindo o erro contra data/labels.csv
# (veja tools/avaliar.py). Eles são o motivo de a contagem ter parado de ficar
# muito abaixo do real em sala cheia.

AC_YOLO_MODELO=yolo11m.pt   # yolo11n/s/m/l/x ou yolov8*. 'm' equilibra CPU x acerto
AC_YOLO_CONF=0.05           # confiança mínima: BAIXA de propósito — aluno meio
                            # escondido pela carteira sai com confiança ~0.1
AC_YOLO_IMGSZ=1280          # resolução de entrada (640 perdia quem está no fundo)
AC_YOLO_IOU=0.6             # NMS interno do YOLO
AC_YOLO_MAX_DET=600         # teto de detecções por passada

# Inferência em ladrilhos: a foto é fatiada e cada pedaço é analisado em tamanho
# cheio. É o que mais melhorou a contagem em sala lotada.
AC_YOLO_LADRILHOS=1         # 0 desliga (volta a analisar só a imagem inteira)
AC_YOLO_LADRILHOS_X=3       # colunas da grade
AC_YOLO_LADRILHOS_Y=2       # linhas da grade
AC_YOLO_SOBREPOSICAO=0.2    # sobreposição entre ladrilhos vizinhos
AC_YOLO_MARGEM_BORDA=-1     # -1 desliga o descarte de corpo cortado na divisa;
                            # use 6 (px) se notar gente contada duas vezes

# Fusão das detecções (imagem inteira + ladrilhos)
AC_YOLO_IOU_FUSAO=0.55      # acima disso, duas caixas viram uma
AC_YOLO_CONTENCAO=0.7       # caixa quase dentro de outra é descartada
AC_YOLO_AREA_MIN=0.00015    # ignora caixa minúscula (ruído)
AC_YOLO_AREA_MAX=0.35       # ignora caixa gigante (parede, grupo inteiro)
AC_YOLO_TTA=0               # 1 = augment/TTA: acerta um pouco mais, ~2x mais lento

# --- Desempenho ---
AC_PRECALCULAR=1            # calcula as cenas em segundo plano ao subir o servidor
# AC_CACHE_DETECCOES=../data/deteccoes.json   # onde o cache é salvo

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
AC_CORS_ORIGIN=*

# --- Calibração da contagem (opcional, desligada por padrão) ---
# pessoas = A * detectado + B. Ajuste com: python tools/calibrar.py
AC_CALIBRACAO_A=1
AC_CALIBRACAO_B=0
